OKE_GAAS_HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oke_gaas?sslmode=disable
OKE_GAAS_ADMIN_API_KEY=replace-with-a-long-random-secret

# Docker Compose self-hosting values. Replace all placeholders before use.
POSTGRES_DB=oke_gaas
POSTGRES_USER=oke_gaas
POSTGRES_PASSWORD=replace-with-a-strong-database-password
OKE_GAAS_HTTP_PORT=8080
