OKE_GAAS_HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oke_gaas?sslmode=disable
OKE_GAAS_ADMIN_API_KEY=
# Optional OTLP/HTTP collector endpoint, for example http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional per-signal endpoint overrides.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Docker Compose self-hosting values. Required secrets are intentionally blank.
POSTGRES_DB=oke_gaas
POSTGRES_USER=oke_gaas
POSTGRES_PASSWORD=
OKE_GAAS_HTTP_PORT=8080
